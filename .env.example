# ⚙️ Variáveis de Ambiente - Forbody V2

# Copie este arquivo para .env.local e preencha com seus valores reais

# ========================
# API & Backend
# ========================
VITE_API_ENDPOINT=https://api.forbody.com.br
VITE_API_KEY=sua_chave_api_aqui

# ========================
# Analytics & Tracking
# ========================
VITE_GA_ID=G-XXXXXXXXXX
VITE_GTAG_ID=
VITE_FACEBOOK_PIXEL_ID=

# ========================
# Contato & Suporte
# ========================
VITE_CONTACT_EMAIL=investimentos@forbody.com.br
VITE_CONTACT_PHONE=+55 11 3333-4444
VITE_CONTACT_WHATSAPP=+55 11 99999-9999

# ========================
# CRM & Email Service
# ========================
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Ou use outro serviço
VITE_MAILCHIMP_API_KEY=
VITE_SENDGRID_API_KEY=

# ========================
# Features & Configuração
# ========================
VITE_ENV=development
VITE_DEBUG=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT=false

# ========================
# Endpoints Customizados
# ========================
VITE_LEADS_ENDPOINT=/api/leads
VITE_CONTACT_ENDPOINT=/api/contact
VITE_SCHEDULE_ENDPOINT=/api/schedule

# ========================
# Social Media
# ========================
VITE_INSTAGRAM_URL=https://instagram.com/forbody
VITE_LINKEDIN_URL=https://linkedin.com/company/forbody
VITE_YOUTUBE_URL=https://youtube.com/@forbody

# ========================
# Integrações 3ª Parto
# ========================
VITE_CALENDLY_URL=
VITE_TYPEFORM_ID=
VITE_ZAPIER_WEBHOOK=

# ========================
# Security
# ========================
VITE_CSRF_TOKEN=
VITE_API_SECRET=

# ========================
# Admin & Auth
# ========================
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ========================
# Google APIs
# ========================
GOOGLE_PLACES_API_KEY=

# ========================
# Supabase
# ========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
